# ========================================================
# .gitignore  — SIKLAS-NB Root
# ========================================================

# ──────────────────────────────────────────────────────────
# 1. User-requested exclusions (docs, design, scratch files)
# ──────────────────────────────────────────────────────────
docs/
documentation/
design_plan/
chtGPT.txt
DESIGN.md
claude --resume 3e8538a4-97d3-4c52-8edc-aee1098f3a8a.txt
claude --resume 4bf3c9cd-ce6b-4c67-9514-c3fe60ee4ff9.txt
claude --resume ea65a309-3e6a-4636-a349-734cf20d875f.txt

# ──────────────────────────────────────────────────────────
# 2. Credential / security files (NEVER commit)
# ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ──────────────────────────────────────────────────────────
# 3. Laravel (backend/)
# ──────────────────────────────────────────────────────────
/backend/vendor/
/backend/node_modules/
/backend/.phpunit.result.cache
/backend/.phpunit.cache/
/backend/storage/*.key
/backend/public/hot
/backend/public/build
/backend/public/storage
/backend/.phpactor.json
/backend/auth.json
/backend/Homestead.json
/backend/Homestead.yaml
/backend/_ide_helper.php

# ──────────────────────────────────────────────────────────
# 4. Vue / Node (frontend/)
# ──────────────────────────────────────────────────────────
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/*.local

# ──────────────────────────────────────────────────────────
# 5. OS / editor / IDE
# ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
.vscode/
!.vscode/extensions.json
.idea/
.nova/
.zed/
.cursor/
.codex/

# ──────────────────────────────────────────────────────────
# 6. Logs & cache
# ──────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.phpunit.result.cache
.phpunit.cache/

# ──────────────────────────────────────────────────────────
# 7. The model (experimental duplicate) — exclude entirely
# ──────────────────────────────────────────────────────────
the model/

# ──────────────────────────────────────────────────────────
# 8. Temporary / generated files
# ──────────────────────────────────────────────────────────
generate_sample_pdfs.php
